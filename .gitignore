# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
# the standalone Studio manages its own dependencies
studio/node_modules
studio/dist
studio/.sanity
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template documents what to set, so it belongs in the repo
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Security reports: findings about this site, never in a public repo
SECURITY-AUDIT-*.md
security-audit*.md

# The widget's node_modules is a symlink to the working copy's, so the test
# suite can resolve `convex/*` from widget/convex. Anchored ignores like
# /node_modules do not cover it, and `git add -A` would otherwise sweep the
# whole tree in.
widget/node_modules

# Built by widget/tests/run.sh before each run. Generated output, and two of
# them are over 100KB of bundled source that would be re-written on every run.
widget/tests/*.bundle.mjs
